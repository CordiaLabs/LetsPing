{
  "name": "@letsping/adapters",
  "version": "0.3.3",
  "description": "LetsPing Framework Adapters for Vercel AI SDK, LangChain, and Cloudflare Agents",
  "files": [
    "dist"
  ],
  "exports": {
    "./vercel": {
      "types": "./dist/vercel.d.ts",
      "import": "./dist/vercel.js",
      "require": "./dist/vercel.js"
    },
    "./langchain": {
      "types": "./dist/langchain.d.ts",
      "import": "./dist/langchain.js",
      "require": "./dist/langchain.js"
    },
    "./approval": {
      "types": "./dist/approval.d.ts",
      "import": "./dist/approval.js",
      "require": "./dist/approval.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "import": "./dist/cloudflare.js",
      "require": "./dist/cloudflare.js"
    },
    "./cloudflare/observability": {
      "types": "./dist/cloudflare-observability.d.ts",
      "import": "./dist/cloudflare-observability.js",
      "require": "./dist/cloudflare-observability.js"
    },
    "./cloudflare/mcp": {
      "types": "./dist/cloudflare-mcp.d.ts",
      "import": "./dist/cloudflare-mcp.js",
      "require": "./dist/cloudflare-mcp.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist .turbo"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "homepage": "https://letsping.co",
  "license": "MIT",
  "keywords": [
    "letsping",
    "agent",
    "hitl",
    "vercel-ai",
    "langchain",
    "cloudflare",
    "durable-objects",
    "adapters"
  ],
  "peerDependencies": {
    "@langchain/core": ">=0.1.0",
    "ai": ">=2.0.0",
    "zod": ">=3.0.0"
  },
  "dependencies": {
    "@letsping/sdk": "0.3.3"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0",
    "ai": "^3.0.0",
    "@langchain/core": "^0.1.0",
    "zod": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CordiaLabs/LetsPing.git",
    "directory": "packages/adapters"
  }
}