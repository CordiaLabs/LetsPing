{
  "name": "@letsping/adapters",
  "version": "0.1.5",
  "description": "LetsPing Framework Adapters for Vercel AI SDK and LangChain",
  "files": [
    "dist"
  ],
  "exports": {
    "./vercel": {
      "types": "./dist/vercel.d.ts",
      "import": "./dist/vercel.js",
      "require": "./dist/vercel.js"
    },
    "./langchain": {
      "types": "./dist/langchain.d.ts",
      "import": "./dist/langchain.js",
      "require": "./dist/langchain.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.1.0",
    "ai": ">=2.0.0",
    "zod": ">=3.0.0"
  },
  "dependencies": {
    "@letsping/sdk": "0.1.5"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0",
    "ai": "^3.0.0",
    "@langchain/core": "^0.1.0",
    "zod": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}